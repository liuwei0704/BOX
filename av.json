nel|live)/i.test(text); const isSmall = el.offsetWidth < 200 && el.offsetHeight < 50; const isCorner = (el.offsetLeft < 50 || el.offsetLeft > window.innerWidth - 200) && (el.offsetTop < 50 || el.offsetTop > window.innerHeight - 50); if (isWatermarkText && (isSmall || isCorner)) { el.style.display = 'none'; el.remove() } } })"]}

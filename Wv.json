{"name":"廣告域名全面封鎖","hosts":["adservice.google.com","doubleclick.net","googlesyndication.com","googleadservices.com","adnxs.com","adsrvr.org","amazon-adsystem.com","scorecardresearch.com","ad.yieldmanager.com","ad.doubleclick.net","pubads.g.doubleclick.net","securepubads.g.doubleclick.net","partnerad.l.doubleclick.net","ad.mo.doubleclick.net","googleads.g.doubleclick.net","tpc.googlesyndication.com","pagead2.googlesyndication.com","adservice.google.com.hk","adservice.google.com.tw"],"regex":[".*"],"action":"block","priority":10},
{"name":"前貼片廣告跳過","hosts":[".*"],"regex":["/preroll/","/pre-roll/","/pre_roll/"],"action":"block","priority":9},
{"name":"中插廣告攔截","hosts":[".*"],"regex":["/midroll/","/in-stream/","/adbreak/","/vast/","/vmap/"],"action":"block","priority":9},
{"name":"後貼片廣告跳過","hosts":[".*"],"regex":["/postroll/","/post-roll/","/end-roll/"],"action":"block","priority":9},
{"name":"廣告路徑屏蔽","hosts":[".*"],"regex":["/ads/","/advertisement/","/advertising/","/sponsored/","/promo/","/promotion/","/banner/","/commercial/","/campaign/","/marketing/","/affiliate/","/partner/","/sponsor/"],"action":"block","priority":8},
{"name":"廣告腳本卸載","hosts":[".*"],"regex":["googletag","pubads","dfp","ima3","vast","vmap","prebid"],"script":["window.googletag=undefined","window.google_ads=undefined","window.ima=undefined","window.ima3=undefined","document.querySelectorAll('script[src*=\"ads\"]').forEach(el=>el.remove())","document.querySelectorAll('script[src*=\"doubleclick\"]').forEach(el=>el.remove())","document.querySelectorAll('script[src*=\"googletag\"]').forEach(el=>el.remove())"],"priority":7},
{"name":"浮水印移除","hosts":[".*"],"regex":[".*"],"script":["document.querySelectorAll('.watermark,.logo,.brand,.sponsor,[class*=\"watermark\"],[id*=\"watermark\"],.ad-watermark,.video-logo,.channel-logo,.corner-logo,.tv-logo,[class*=\"brand\"],[id*=\"brand\"],[class*=\"sponsor\"],[id*=\"sponsor\"]').forEach(el=>el.style.display='none')"],"priority":6},
{"name":"廣告容器隱藏","hosts":[".*"],"regex":[".*"],"script":["conststyle=document.createElement('style');style.textContent=`.ad-container,.ad-wrapper,.ad-banner,.ad-placement,[class*=\"ad-container\"],[id*=\"ad-container\"],[class*=\"ad-wrapper\"],[id*=\"ad-wrapper\"],[class*=\"ad-banner\"],[id*=\"ad-banner\"],[class*=\"ad-placement\"],[id*=\"ad-placement\"],.video-ads,.vjs-ads,.vjs-ad-container,[data-ad],[data-ads],[data-advertisement]{display:none!important;height:0!important;width:0!important;opacity:0!important;pointer-events:none!important;}`;document.head.appendChild(style)"]},
{"name":"YouTube廣告跳過","hosts":["youtube.com","youtu.be","googlevideo.com"],"regex":["/ad/","&ad=","adunit","adformat"],"script":["document.querySelectorAll('.ytp-ad-player-overlay,.ytp-ad-overlay,.ytp-ad-image-overlay,.ytp-ad-text-overlay,.video-ads,.ytp-ad-skip-button-container,.ytp-ad-skip-button-modern,.ytp-ad-skip-button,.ytp-skip-ad').forEach(el=>{if(el.style)el.style.display='none';if(el.click)el.click()})","document.querySelectorAll('.ytp-ad-skip-button-modern,.ytp-ad-skip-button,.ytp-skip-ad,[aria-label*=\"跳過\"],[aria-label*=\"Skip\"]').forEach(el=>{setTimeout(()=>el.click(),1000)})"]},
{"name":"HLS廣告標記過濾","hosts":[".*"],"regex":["#EXT-X-CUE","#EXT-X-SCTE35","#EXT-X-DATERANGE","scte35"],"action":"block"},
{"name":"綜合廣告過濾","hosts":[".*"],"regex":["/ad/","/ads/","adserver","doubleclick","googleads","googlesyndication","pubads"],"action":"block","priority":5},
{"name":"影片浮水印文字移除","hosts":[".*"],"regex":[".*"],"priority":6,"script":["document.querySelectorAll('.video-watermark, .video-logo, .channel-logo, .tv-logo, .brand-watermark, .watermark, .logo, .brand, .copyright, .site-logo, .channel-brand, .corner-logo, .powered-by, .sponsor-logo, .ad-watermark, .watermark-ad, [class*=\"watermark\"], [id*=\"watermark\"], [class*=\"logo\"], [id*=\"logo\"], [class*=\"brand\"], [id*=\"brand\"]').forEach(el => el.style.display = 'none')","document.querySelectorAll('[style*=\"position:absolute\"], [style*=\"position:fixed\"], [style*=\"position:sticky\"]').forEach(el => { const rect = el.getBoundingClientRect(); const isCorner = (rect.left < 50 || rect.right > window.innerWidth - 50) && (rect.top < 50 || rect.bottom > window.innerHeight - 50); const hasAdText = el.innerText && (el.innerText.includes('广告') || el.innerText.includes('贊助') || el.innerText.includes('sponsor') || el.innerText.includes('ad')); if ((isCorner || hasAdText) && el.offsetWidth < 300 && el.offsetHeight < 300) { el.style.display = 'none'; el.remove() } })","document.querySelectorAll('canvas, svg').forEach(el => { const parent = el.parentElement; const isWatermark = el.style.position === 'absolute' || el.style.position === 'fixed' || el.style.opacity === '0.3' || el.style.opacity === '0.5'; const hasAd = parent && (parent.innerText?.includes('广告') || parent.innerText?.includes('贊助') || parent.innerText?.includes('sponsor')); if (isWatermark || hasAd) { el.style.display = 'none'; el.remove() } })","document.querySelectorAll('[style*=\"background-image\"]').forEach(el => { const style = el.style.backgroundImage || ''; if (style.includes('watermark') || style.includes('logo') || style.includes('brand') || style.includes('ad')) { el.style.backgroundImage = 'none' } })","document.querySelectorAll('*').forEach(el => { if (el.children.length === 0 && el.innerText) { const text = el.innerText.trim(); const isWatermarkText = /(版權所有|©|®|™|贊助|廣告|sponsor|ad|powered by|video|channel|live)/i.test(text); const isSmall = el.offsetWidth < 200 && el.offsetHeight < 50; const isCorner = (el.offsetLeft < 50 || el.offsetLeft > window.innerWidth - 200) && (el.offsetTop < 50 || el.offsetTop > window.innerHeight - 50); if (isWatermarkText && (isSmall || isCorner)) { el.style.display = 'none'; el.remove() } } })"]}
]

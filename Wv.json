{"name":"彈窗攔截","hosts":[".*"],"regex":["popup","ad","banner"],"script":["document.querySelectorAll('.modal,.popup,.overlay').forEach(el=>el.style.display='none')","document.querySelectorAll('[class*=\"ad\"],[id*=\"ad\"]').forEach(el=>el.remove())"]},

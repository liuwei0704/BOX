    "分类名称": "电影&剧集&动漫&综艺&排行榜&专题",
    "分类名称替换词": "1&2&3&4&rank&topic",
    
    // 筛选配置
    "筛选数据": "ext",
    "筛选子分类名称": "动作&喜剧&爱情&科幻&恐怖&悬疑&犯罪&战争&动画&冒险&历史&灾难&纪录&剧情",
    "筛选子分类替换词": "动作&喜剧&爱情&科幻&恐怖&悬疑&犯罪&战争&动画&冒险&历史&灾难&纪录&剧情",
    "筛选地区名称": "大陆&香港&台湾&美国&日本&韩国&泰国&印度&英国&法国&德国&加拿大&西班牙&意大利&澳大利亚",
    "筛选地区替换词": "大陆&香港&台湾&美国&日本&韩国&泰国&印度&英国&法国&德国&加拿大&西班牙&意大利&澳大利亚",
    "筛选排序名称": "人气&最新&评分&年份",
    "筛选排序替换词": "hits&time&score&year",
    
    // ============ XBPQ增强配置 ============
    
    // 基础配置
    "编码": "UTF-8",
    "站名": "3Q影视",
    "域名-c": "https://www.55kan.com",
    
    // 分类链接
    "分类url": "{{域名-c}}/vodshow/{cateId}----------{catePg}---.html",
    
    // 使用JSON模式获取列表
    "数组": "j:list",
    "标题": "j:vod_name",
    "图片": "j:vod_pic",
    "副标题": "j:vod_remarks",
    "链接": "{{域名-c}}/vd/+j:vod_id+.html",
    
    // 详情页配置
    "详情图片": "p:.info-main img.lazy->data-original",
    "影片类型": "p:span:contains(剧情)[替换:/>>#]分割(#)[含序号:1]",
    "影片年代": "p:span:contains(2025):first->text",
    "影片地区": "p:span:contains(中国大陆):first->text",
    "导演": "p:div:contains(导演) a->text[替换:#>>、]",
    "主演": "p:div:contains(主演) a->text[替换:#>>、]",
    "简介": "p:.line-clamp-5->text",
    
    // 播放列表配置 - 从window.PLAYLIST_DATA获取
    "播放二次截取": "window.PLAYLIST_DATA&&};",
    "播放数组": "j:*",
    "线路标题": "j:player_info.show",
    "线路数组": "j:urls.*",
    "播放标题": "j:name",
    "播放链接": "j:url",
    
    // 搜索配置
    "搜索url": "{{域名-c}}/search/{wd}----------1---.html",
    "搜索模式": "1",
    "搜索数组": "p:.stui-vodlist li",
    "搜索图片": "p:.lazyload->data-original",
    "搜索标题": "p:h4 a->text",
    "搜索链接": "p:h4 a->href",
    "搜索链接加前缀": "{{域名-c}}",
    
    // 解析配置 - 针对加密链接
    "解析": "NBY${{域名-c}}/player/NBY.php?vid=||默认${{域名-c}}",
    

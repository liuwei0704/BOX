    "數組": "<article&&</article>[不含:旗士]",
    
    // 圖片：保持從 JS 函數中提取
    "圖片": "loadBannerDirect('&&'",
    
    // 標題：精準定位 headline 屬性
    "標題": "itemprop=\"headline\">&&<",
    
    // 副標題：提取發佈日期
    "副標題": "itemprop=\"datePublished\" content=\"&&\"",
    
    // 連結：確保提取到的 /archives/... 能自動補上域名
    "連結": "href=\"&&\"",

    // --- 詳情頁截取 ---
    // 簡介：改用更寬鬆的正則，或者 Jsoup 
    "簡介": "itemprop=\"description\">&&<||p:blockquote->text",
    
    // 播放跳轉：根據你之前的配置，這部分通常在頁面源碼的 script 或 json 數據中
    "跳轉播放連結": "video\":{\"url\":\"&&\"",
